---
// Cabecera del sitio: barra superior con LangToggle + ThemeToggle, marca
// (COMPANY.name) y navegacion principal via HeaderNav. El script marca el enlace
// activo al instante y navega tras la animacion (520 ms). Montada en BaseLayout.
import { COMPANY } from '../data/site';
import { altLocaleHref, getLang, href, t } from '../i18n';
import HeaderNav from './HeaderNav';
import LangToggle from './LangToggle';
import ThemeToggle from './ThemeToggle.astro';
import '../styles/header.css';
import '../styles/nav.css';

const lang = getLang(Astro.params);
const ui = t(lang);
const pathname = Astro.url.pathname;
---

<header class="header">
	<div class="header__top">
		<div class="header__top-inner">
			<LangToggle
				href={altLocaleHref(pathname, lang)}
				label={ui.lang.label}
				ariaLabel={ui.lang.toggleLabel}
			/>
			<ThemeToggle />
		</div>
	</div>
	<div class="header__main">
		<div class="header__main-inner">
			<a class="header__brand" href={href('/', lang)}>
				<span class="header__name">{COMPANY.name}</span>
			</a>
		</div>
	</div>
	<nav class="header__nav" aria-label={ui.nav.ariaLabel}>
		<div class="header__nav-inner">
			<HeaderNav lang={lang} pathname={pathname} labels={ui.nav.labels} />
		</div>
	</nav>
</header>

<script>
	const headerNav = document.querySelector('.header__nav');
	const navList = headerNav?.querySelector('.nav__list');

	if (headerNav && navList) {
		const items = headerNav.querySelectorAll<HTMLElement>('.nav__item');

		requestAnimationFrame(() => {
			requestAnimationFrame(() => navList.classList.add('js-nav-ready'));
		});

		items.forEach((item) => {
			item.addEventListener('click', (event: MouseEvent) => {
				if (
					event.defaultPrevented ||
					event.button !== 0 ||
					event.metaKey ||
					event.ctrlKey ||
					event.shiftKey ||
					event.altKey
				) {
					return;
				}
				const link = item.querySelector('a');
				if (!link) return;
				event.preventDefault();

				items.forEach((i) => {
					i.classList.remove('nav__item--active');
					i.querySelector('.nav__link')?.classList.remove('nav__link--active');
				});
				item.classList.add('nav__item--active');
				link.classList.add('nav__link--active');

				setTimeout(() => {
					window.location.href = link.href;
				}, 520);
			});
		});
	}
</script>

<script>
	// Oculta el header al bajar y lo muestra al subir. Se usa rAF para no
	// saturar el hilo principal y un umbral (HIDE_OFFSET) para ignorar
	// micro-movimientos. Cerca del tope el header siempre queda visible.
	const header = document.querySelector<HTMLElement>('.header');

	if (header) {
		let lastScrollTop: number = window.scrollY;
		let ticking: boolean = false;
		const HIDE_OFFSET: number = 8;

		const update = (): void => {
			const current: number = window.scrollY;
			if (current <= 0) {
				header.classList.remove('header--hidden');
			} else {
				const delta: number = current - lastScrollTop;
				if (Math.abs(delta) >= HIDE_OFFSET) {
					header.classList.toggle('header--hidden', delta > 0);
				}
			}
			lastScrollTop = current;
			ticking = false;
		};

		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true },
		);
	}
</script>