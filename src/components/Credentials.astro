---
// Seccion "Credenciales" de la pagina Nosotros: lista titulo+texto desde
// data/trust (CREDENTIALS); si la lista esta vacia muestra PendingBlock.
import { CREDENTIALS } from '../data/trust';
import { getLang, t } from '../i18n';
import type { Locale } from '../i18n';
import PendingBlock from './PendingBlock.astro';
import SectionTitle from './SectionTitle.astro';

interface Props {
	lang?: Locale;
}

const { lang = getLang(Astro.params) } = Astro.props;
const ui = t(lang);
---

<section class="section">
	<div class="container-page">
		<SectionTitle
			kicker={ui.trust.credentials.kicker}
			title={ui.trust.credentials.title}
			subtitle={ui.trust.credentials.subtitle}
		/>

		{CREDENTIALS.length > 0 ? (
			<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{CREDENTIALS.map((item) => (
					<li class="rounded-lg border border-border bg-surface p-6">
						<h3 class="text-lg font-bold text-ink">{item.title}</h3>
						<p class="mt-2 text-sm text-body">{item.text}</p>
					</li>
				))}
			</ul>
		) : (
			<PendingBlock lang={lang} />
		)}
	</div>
</section>
