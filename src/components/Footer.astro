---
// Pie de pagina: bloque de contacto (MapEmbed + direccion/tel/email), columna
// de "creado por" + redes, formulario ContactExpress y barra legal con
// PrivacyModal/TermsModal. Montado en BaseLayout.
import { ADDRESS, COMPANY, EMAIL, MAPS_DIRECTIONS_URL, PHONE, SOCIAL, WHATSAPP } from '../data/site';
import { getLang, t } from '../i18n';
import ContactExpress from './ContactExpress.astro';
import MapEmbed from './MapEmbed.astro';
import PrivacyModal from './PrivacyModal.astro';
import TermsModal from './TermsModal.astro';
import '../styles/footer.css';

const lang = getLang(Astro.params);
const ui = t(lang);
const year = new Date().getFullYear();
---

<footer class="footer" id="footer">
	<div class="footer__contact">
		<div class="footer__contact-grid">
			<MapEmbed />
			<div>
				<h3 class="footer__address-title">{COMPANY.name}</h3>
				<div class="mt-6 space-y-4">
				<p class="footer__address-line">
					<svg class="footer__address-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
						<circle cx="12" cy="10" r="3" />
					</svg>
					<a
						class="footer__address-link"
						href={MAPS_DIRECTIONS_URL}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={ui.map.directions}
					>
						{ADDRESS.line1}
						<br />
						{ADDRESS.line2}, {ADDRESS.country}
					</a>
				</p>
				<p>
					<a class="footer__link" href={PHONE.link}>
						<svg class="h-9 w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
						</svg>
						{PHONE.display}
					</a>
				</p>
				<p>
					<a class="footer__link" href={EMAIL.link}>
						<img class="footer__link-img" src="/gmail.svg" alt="" aria-hidden="true" />
						{EMAIL.display}
					</a>
				</p>
				</div>
			</div>
		</div>
	</div>

	<div class="footer__main">
		<div class="footer__grid">
			<div class="footer__created">
				<p class="footer__created-label">{ui.footer.createdBy}</p>
				<a
					class="footer__created-logo"
					href={COMPANY.portfolioUrl}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={ui.footer.logoAria}
				>
					<img class="footer__created-img footer__logo" src="/AlanLogo.svg" alt={ui.footer.logoAria} />
				</a>
			</div>
			<div class="footer__social-col">
				<h4 class="footer__block-title">{ui.footer.contactanos}</h4>
				<ul class="footer__social">
					<li>
						<a class="footer__link" href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer" aria-label={ui.footer.facebookAria}>
							<img class="footer__link-img" src="/facebook-svgrepo-com.svg" alt="" aria-hidden="true" />
						</a>
					</li>
					<li>
						<a class="footer__link" href={WHATSAPP.url} target="_blank" rel="noopener noreferrer" aria-label={ui.footer.whatsappAria}>
							<img class="footer__link-img" src="/whatsapp.svg" alt="" aria-hidden="true" />
						</a>
					</li>
					<li>
						<a class="footer__link" href={EMAIL.link} aria-label={ui.footer.gmailAria}>
							<img class="footer__link-img" src="/gmail.svg" alt="" aria-hidden="true" />
						</a>
					</li>
				</ul>
			</div>
			<div class="footer__express" id="contacto-express" tabindex="-1">
				<h4 class="footer__block-title">{ui.footer.contactoExpress}</h4>
				<ContactExpress idPrefix="ce-footer" />
			</div>
		</div>
	</div>

	<div class="footer__legal">
		<div class="footer__legal-inner">
			<p>
				{ui.footer.rights(year, COMPANY.name)}
			</p>
			<div class="footer__legal-links">
				<PrivacyModal />
				<TermsModal />
				<a
					class="footer__legal-link"
					href={COMPANY.portfolioUrl}
					target="_blank"
					rel="noopener noreferrer"
				>
					{ui.footer.contactCreator}
				</a>
			</div>
		</div>
	</div>
</footer>
