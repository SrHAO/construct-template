---
// Pagina de contacto: datos de la empresa (tel, email, horario, Maps) +
// formulario ContactExpress + MapEmbed + CTA de WhatsApp.
import Button from '../../components/Button.astro';
import ContactExpress from '../../components/ContactExpress.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import { ADDRESS, COMPANY, EMAIL, MAPS_DIRECTIONS_URL, PHONE, PHONE_ALT, WHATSAPP } from '../../data/site';
import { getLang, t } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
	return [
		{ params: { lang: 'es' } },
		{ params: { lang: 'en' } },
	];
}

const lang = getLang(Astro.params);
const ui = t(lang);
---

<BaseLayout lang={lang} title={ui.contacto.title} description={ui.contacto.lead}>
	<section class="page-head">
		<div class="page-head__inner">
			<h1 class="page-head__title">{ui.contacto.title}</h1>
			<p class="page-head__lead">
				{ui.contacto.lead}
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container-page grid gap-10 lg:grid-cols-2">
			<div>
<p class="text-sm font-bold tracking-widest text-accent-darkest uppercase dark:text-accent">{ui.contacto.expressKicker}</p>
			<h2 class="mt-2 text-2xl font-bold text-ink sm:text-3xl">{ui.contacto.enviarTitulo}</h2>
			<p class="mt-3 text-muted">
				{ui.contacto.formText}
			</p>
				<div class="mt-6">
					<ContactExpress lang={lang} idPrefix="ce-page" />
				</div>
			</div>

			<div class="space-y-6">
<div class="rounded-lg border border-border bg-surface-raised p-6 shadow-sm">
				<h3 class="text-lg font-bold text-ink">{COMPANY.name}</h3>
				<div class="mt-4 space-y-3 text-muted">
					<p>
						<a
							class="flex items-center gap-2 font-semibold text-body hover:text-brand-dark"
							href={MAPS_DIRECTIONS_URL}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={ui.map.directions}
						>
							{ADDRESS.line1}, {ADDRESS.line2}, {ADDRESS.country}
						</a>
					</p>
					<p>
						<a class="flex items-center gap-2 font-semibold text-body hover:text-brand-dark" href={PHONE.link}>
								<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
								</svg>
								{ui.contacto.tel} {PHONE.display}
							</a>
						</p>
						<p>
							<a class="flex items-center gap-2 font-semibold text-body hover:text-brand-dark" href={PHONE_ALT.link}>
								<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
								</svg>
								{ui.contacto.telAlterno} {PHONE_ALT.display}
							</a>
						</p>
						<p class="flex items-center gap-3">
							<a class="flex items-center gap-2 font-semibold text-body hover:text-brand-dark" href={EMAIL.link}>
								<img class="h-5 w-5" src="/gmail.svg" alt="" aria-hidden="true" />
								{EMAIL.display}
							</a>
							<a class="inline-flex items-center text-body transition-colors hover:text-brand-dark" href={WHATSAPP.url} target="_blank" rel="noopener noreferrer" aria-label={ui.footer.whatsappAria}>
								<img class="h-5 w-5" src="/whatsapp.svg" alt="" aria-hidden="true" />
							</a>
						</p>
					</div>
				</div>

				<MapEmbed lang={lang} />

				<div class="flex flex-wrap gap-3">
					<Button href={WHATSAPP.url} target="_blank" variant="whatsapp">{ui.common.chatearWhatsapp}</Button>
					<Button href={EMAIL.link} variant="primary">{ui.common.enviarCorreo}</Button>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>